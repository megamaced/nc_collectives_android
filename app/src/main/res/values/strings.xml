    <!-- Under "Needs attention": unseen alerts, as one row that opens the Alerts tab. -->
    <plurals name="home_new_alerts">
        <item quantity="one">%1$d new alert</item>
        <item quantity="other">%1$d new alerts</item>
    </plurals>
    <string name="home_new_alerts_detail">Mentions and changes in your collectives</string>
    <!-- Why a page needs attention. "Unsaved changes" are edits the server's version conflicted with; "an edit waiting to sync" is an edit saved offline. -->
    <string name="home_attention_conflict_and_queued">Unsaved changes on this device · an edit waiting to sync</string>
    <string name="home_attention_conflict">Unsaved changes on this device</string>
    <string name="home_attention_queued">Saved offline — waiting to sync</string>
    <!-- %1$s is the new page's title. -->
    <string name="home_page_created">Created “%1$s”</string>
    <!-- Making a page from Home, which first asks which collective it goes in. -->
    <string name="home_new_page_which_collective">Which collective?</string>
    <string name="home_new_page_pick_collective_hint">Pick a collective…</string>
    <string name="home_new_page_pick_collective">Pick a collective</string>
    <!-- A section's full list, behind "See all". -->
    <string name="home_section_all_caught_up_title">All caught up</string>
    <string name="home_section_all_caught_up_message">No conflicts to resolve and no edits waiting to sync.</string>
    <string name="home_section_empty_title">Nothing here</string>
    <string name="home_section_empty_message">No pages to show here right now.</string>

